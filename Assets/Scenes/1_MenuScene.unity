  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Molz \u2013 Qu\xEDmica em Jogo te convida a explorar a Qu\xEDmica Org\xE2nica
    de forma <b>pr\xE1tica e interativa</b>.\r\n\r\nDurante a experi\xEAncia, voc\xEA
    <b>analisa subst\xE2ncias, realiza testes de solubilidade e descobre como identificar
    compostos org\xE2nicos</b>, como em uma bancada de laborat\xF3rio.\r\n\r\n<b>Voc\xEA
    vai explorar</b>:\r\n\u2022 Solubilidade em diferentes solventes\r\n\u2022 Grupos
    funcionais org\xE2nicos\r\n\u2022 Densidade e estado f\xEDsico\r\n\u2022 Indicadores
    \xE1cido-base\r\n\u2022 Classifica\xE7\xE3o por \xE1rvore de decis\xE3o\r\n"
  m_isRightToLeft: 0
