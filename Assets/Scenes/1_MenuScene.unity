      m_Calls: []
  m_text: "Em Molz \u2013 Qu\xEDmica em Jogo, seu objetivo \xE9 identificar o composto
    correto a <b>partir dos testes</b> realizados no laborat\xF3rio.\r\n\r\nAo longo
    da partida, voc\xEA <b>observa o comportamento da subst\xE2ncia em diferentes
    solventes</b>, usa o papel tornassol e interpreta os resultados para tomar sua
    decis\xE3o.\r\n\r\n<b>Como jogar</b>:\r\n\u2022 Escolha a dificuldade\n\u2022
    Fa\xE7a os testes no laborat\xF3rio\r\n\u2022 Observe os resultados\r\n\u2022
    Consulte a \xE1rvore de decis\xE3o\r\n\u2022 Responda corretamente para avan\xE7ar
    ao conversar com o Molz"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 745e9d7dd48726f48bf2a3ad22552048, type: 2}
  m_sharedMaterial: {fileID: -5749240162441900614, guid: 745e9d7dd48726f48bf2a3ad22552048, type: 2}
