            {
              "id": "S100",
              "shortDescription": {
                "text": "Methods and properties should be named in PascalCase"
              },
              "fullDescription": {
                "text": "Shared naming conventions allow teams to collaborate efficiently."
              },
              "defaultConfiguration": {
                "enabled": false
              },
              "properties": {
