                ]
              }
            },
            {
              "id": "S1006",
              "shortDescription": {
                "text": "Method overrides should not change parameter defaults"
              },
              "fullDescription": {
                "text": "Default arguments are determined by the static type of the object."
              },
              "properties": {
                "category": "Critical Code Smell",
                "tags": [
